{
  "info": {
    "name": "E-Commerce API",
    "description": "Production-grade E-Commerce Backend API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "https://backent-ecommerce-production.up.railway.app/api/v1"
    },
    { "key": "token", "value": "" }
  ],
  "item": [
    {
      "name": "🔐 Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/auth/register",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Amar Dev\",\n  \"email\": \"amar@test.com\",\n  \"password\": \"Test@1234\"\n}"
            }
          }
        },
        {
          "name": "Login (User)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.data?.token) pm.collectionVariables.set('token', res.data.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{base_url}}/auth/login",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@shop.com\",\n  \"password\": \"User@123\"\n}"
            }
          }
        },
        {
          "name": "Login (Admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.data?.token) pm.collectionVariables.set('admin_token', res.data.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{base_url}}/auth/login",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@shop.com\",\n  \"password\": \"Admin@123\"\n}"
            }
          }
        },
        {
          "name": "Get My Profile",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/auth/me",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        },
        {
          "name": "Refresh Token",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/auth/refresh",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"REPLACE_WITH_REFRESH_TOKEN\"\n}"
            }
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/auth/logout",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        }
      ]
    },
    {
      "name": "📦 Products",
      "item": [
        {
          "name": "Get All Products",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/products?page=1&limit=20",
              "host": ["{{base_url}}"],
              "path": ["products"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "20" },
                { "key": "category", "value": "smartphones", "disabled": true },
                { "key": "search", "value": "samsung", "disabled": true },
                { "key": "minPrice", "value": "1000", "disabled": true },
                { "key": "maxPrice", "value": "50000", "disabled": true },
                { "key": "sort", "value": "price_asc", "disabled": true },
                { "key": "tags", "value": "flagship,android", "disabled": true }
              ]
            }
          }
        },
        {
          "name": "Get Product by Slug",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/products/samsung-galaxy-s24-ultra"
          }
        },
        {
          "name": "Search Products",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/products?search=iphone&limit=5"
          }
        },
        {
          "name": "Filter by Category + Price",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/products?category=laptops&minPrice=50000&maxPrice=150000&sort=price_asc"
          }
        },
        {
          "name": "Create Product (Admin)",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/products",
            "header": [
              { "key": "Authorization", "value": "Bearer {{admin_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test Product\",\n  \"description\": \"This is a test product description\",\n  \"price\": 9999,\n  \"comparePrice\": 12999,\n  \"stock\": 50,\n  \"sku\": \"TEST-001\",\n  \"images\": [\"https://picsum.photos/seed/test/600/600\"],\n  \"tags\": [\"test\", \"demo\"],\n  \"categoryId\": \"REPLACE_WITH_REAL_CATEGORY_ID\"\n}"
            }
          }
        },
        {
          "name": "Update Product (Admin)",
          "request": {
            "method": "PATCH",
            "url": "{{base_url}}/products/PRODUCT_ID",
            "header": [
              { "key": "Authorization", "value": "Bearer {{admin_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"price\": 8999,\n  \"stock\": 45\n}"
            }
          }
        },
        {
          "name": "Delete Product (Admin)",
          "request": {
            "method": "DELETE",
            "url": "{{base_url}}/products/PRODUCT_ID",
            "header": [
              { "key": "Authorization", "value": "Bearer {{admin_token}}" }
            ]
          }
        }
      ]
    },
    {
      "name": "🗂️ Categories",
      "item": [
        {
          "name": "Get All Categories",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/categories"
          }
        },
        {
          "name": "Get Category by Slug",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/categories/smartphones"
          }
        },
        {
          "name": "Create Category (Admin)",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/categories",
            "header": [
              { "key": "Authorization", "value": "Bearer {{admin_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Tablets\",\n  \"description\": \"Tablet devices\",\n  \"image\": \"https://picsum.photos/seed/tablet/600/600\"\n}"
            }
          }
        },
        {
          "name": "Update Category (Admin)",
          "request": {
            "method": "PATCH",
            "url": "{{base_url}}/categories/CATEGORY_ID",
            "header": [
              { "key": "Authorization", "value": "Bearer {{admin_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"description\": \"Updated description\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "🛒 Cart",
      "item": [
        {
          "name": "Get Cart",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/cart",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        },
        {
          "name": "Add Item to Cart",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/cart/items",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productId\": \"REPLACE_WITH_PRODUCT_ID\",\n  \"quantity\": 2\n}"
            }
          }
        },
        {
          "name": "Update Cart Item",
          "request": {
            "method": "PATCH",
            "url": "{{base_url}}/cart/items/CART_ITEM_ID",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"quantity\": 3\n}"
            }
          }
        },
        {
          "name": "Remove Cart Item",
          "request": {
            "method": "DELETE",
            "url": "{{base_url}}/cart/items/CART_ITEM_ID",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        },
        {
          "name": "Clear Cart",
          "request": {
            "method": "DELETE",
            "url": "{{base_url}}/cart",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        }
      ]
    },
    {
      "name": "📋 Orders",
      "item": [
        {
          "name": "Place Order",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/orders",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"note\": \"Please deliver before 6 PM\"\n}"
            }
          }
        },
        {
          "name": "Get My Orders",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/orders/my?page=1&limit=10",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        },
        {
          "name": "Get My Order by ID",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/orders/my/ORDER_ID",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        },
        {
          "name": "Cancel Order",
          "request": {
            "method": "PATCH",
            "url": "{{base_url}}/orders/my/ORDER_ID/cancel",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        },
        {
          "name": "Get All Orders (Admin)",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/orders?page=1&status=PENDING",
            "header": [
              { "key": "Authorization", "value": "Bearer {{admin_token}}" }
            ]
          }
        },
        {
          "name": "Update Order Status (Admin)",
          "request": {
            "method": "PATCH",
            "url": "{{base_url}}/orders/ORDER_ID/status",
            "header": [
              { "key": "Authorization", "value": "Bearer {{admin_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"SHIPPED\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "❤️ Wishlist",
      "item": [
        {
          "name": "Get Wishlist",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/wishlist",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        },
        {
          "name": "Add to Wishlist",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/wishlist",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productId\": \"REPLACE_WITH_PRODUCT_ID\"\n}"
            }
          }
        },
        {
          "name": "Remove from Wishlist",
          "request": {
            "method": "DELETE",
            "url": "{{base_url}}/wishlist/PRODUCT_ID",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        },
        {
          "name": "Move to Cart",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/wishlist/PRODUCT_ID/move-to-cart",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        },
        {
          "name": "Check if in Wishlist",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/wishlist/PRODUCT_ID/check",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        }
      ]
    },
    {
      "name": "👤 User",
      "item": [
        {
          "name": "Get Addresses",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/users/addresses",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        },
        {
          "name": "Add Address",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/users/addresses",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Amar Kumar\",\n  \"phone\": \"9876543210\",\n  \"line1\": \"123 MG Road\",\n  \"line2\": \"Near City Mall\",\n  \"city\": \"Satna\",\n  \"state\": \"Madhya Pradesh\",\n  \"pincode\": \"485001\",\n  \"isDefault\": true\n}"
            }
          }
        },
        {
          "name": "Submit Review",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/users/reviews",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productId\": \"REPLACE_WITH_PRODUCT_ID\",\n  \"rating\": 5,\n  \"comment\": \"Excellent product, fast delivery!\"\n}"
            }
          }
        },
        {
          "name": "Delete Address",
          "request": {
            "method": "DELETE",
            "url": "{{base_url}}/users/addresses/ADDRESS_ID",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        }
      ]
    },
    {
      "name": "📊 Admin Analytics",
      "item": [
        {
          "name": "Dashboard Stats",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/admin/dashboard",
            "header": [
              { "key": "Authorization", "value": "Bearer {{admin_token}}" }
            ]
          }
        },
        {
          "name": "Revenue Chart (30 days)",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/admin/revenue/chart?days=30",
            "header": [
              { "key": "Authorization", "value": "Bearer {{admin_token}}" }
            ]
          }
        },
        {
          "name": "Orders by Status",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/admin/orders/status",
            "header": [
              { "key": "Authorization", "value": "Bearer {{admin_token}}" }
            ]
          }
        },
        {
          "name": "Top 10 Products",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/admin/products/top?limit=10",
            "header": [
              { "key": "Authorization", "value": "Bearer {{admin_token}}" }
            ]
          }
        },
        {
          "name": "Low Stock Products",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/admin/products/low-stock?threshold=10",
            "header": [
              { "key": "Authorization", "value": "Bearer {{admin_token}}" }
            ]
          }
        },
        {
          "name": "Top Categories by Revenue",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/admin/categories/top",
            "header": [
              { "key": "Authorization", "value": "Bearer {{admin_token}}" }
            ]
          }
        },
        {
          "name": "Recent Orders",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/admin/orders/recent?limit=10",
            "header": [
              { "key": "Authorization", "value": "Bearer {{admin_token}}" }
            ]
          }
        }
      ]
    }
  ]
}
