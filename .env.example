# App
PORT=5000
NODE_ENV=development

# Database
DATABASE_URL=postgresql://postgres:postgres123@postgres:5432/ecommerce_db

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your_refresh_secret_key
JWT_REFRESH_EXPIRES_IN=30d

# Redis
REDIS_URL=redis://localhost:6379

# Optional: Admin seed credentials
ADMIN_EMAIL=admin@shop.com
ADMIN_PASSWORD=Admin@123

# Token expiry
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Auto-delete users after X days (0 = disabled)
USER_AUTO_DELETE_DAYS=7

# Protected default user emails (comma-separated)
PROTECTED_EMAILS=admin@shop.com,user@shop.com,demo1@shop.com,demo2@shop.com
